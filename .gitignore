# Credentials / runtime outputs are never versioned
.env
.env.*
!.env.example
*.pem
*.key
*.token
hosts.yml
credentials*
__pycache__/
*.pyc
.venv/
output/
*.mp3
!assets/audio/whale-chan-voice-sample.mp3
*.wav
*.log
# Optional attic images are kept in the archive download
archive/reference-library/*.png
archive/reference-library/*.jpg
archive/reference-library/*.jpeg
archive/reference-library/*.webp
archive/reference-library/*.gif
# Downloaded bundles stay outside source control
*.zip
